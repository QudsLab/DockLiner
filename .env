# DockLiner environment configuration
# Restart the application after editing for changes to take full effect.

# -----------------------------------------------------------------------------
# Core server settings
# Required for the application to start. HOST accepts a comma-separated list of interfaces. PORT defaults to 50021 (the first prime in the 50xxx range). If PORT is occupied and PORT_SELECTION=auto, ALLOWED_PORTS is tried in order.
# -----------------------------------------------------------------------------
# Root session secret — auto-generated if left as change-me
DOCKLINER_SECRET_KEY=1efd93e4a37a6f5ba1ee3a6b94ec89e4cd735093deb40f5ee2c03af344bcffa2
# Comma-separated interfaces, e.g. 0.0.0.0,127.0.0.1,::1
DOCKLINER_HOST=0.0.0.0
# Port to listen on (default 50021)
DOCKLINER_PORT=60021
# strict = fail if occupied | auto = pick next prime from ALLOWED_PORTS
DOCKLINER_PORT_SELECTION=strict
# Prime fallback ports when PORT_SELECTION=auto
DOCKLINER_ALLOWED_PORTS=50021,50023,50033,50047,50051,50053,50069,50077,50087,50093,50101,50111,50119,50123
# systemd / Windows service name for Save & Restart
DOCKLINER_SERVICE=dockliner

# -----------------------------------------------------------------------------
# Database mode
# auto | test | live. auto resolves to live if any DB_LIVE_* var is set, otherwise test. SQLite is auto-migrated. Live mode with MySQL/Postgres is strict.
# -----------------------------------------------------------------------------
DOCKLINER_DB_MODE=auto

# -----------------------------------------------------------------------------
# Database type
# sqlite | mysql | postgres. mysql is the canonical default. For SQLite, no further credentials are required.
# -----------------------------------------------------------------------------
# sqlite is the zero-config default; mysql/postgres require credentials
DOCKLINER_DB_TYPE=sqlite

# -----------------------------------------------------------------------------
# Live database credentials
# Required when DB_MODE=live and DB_TYPE is not sqlite. DOCKLINER_USERS passwords must be BLAKE3 512-bit hex hashes (128 hex chars).
# -----------------------------------------------------------------------------
# DOCKLINER_DB_LIVE_HOST=localhost
# DOCKLINER_DB_LIVE_PORT=3306
# DOCKLINER_DB_LIVE_USER=dockliner
# DOCKLINER_DB_LIVE_PASSWORD=
# DOCKLINER_DB_LIVE_NAME=dockliner

# -----------------------------------------------------------------------------
# Test database credentials
# Required when DB_MODE=test and DB_TYPE is not sqlite. These are used for the test/isolated database.
# -----------------------------------------------------------------------------
# DOCKLINER_DB_TEST_HOST=localhost
# DOCKLINER_DB_TEST_PORT=3306
# DOCKLINER_DB_TEST_USER=dockliner
# DOCKLINER_DB_TEST_PASSWORD=
# DOCKLINER_DB_TEST_NAME=dockliner_test

# -----------------------------------------------------------------------------
# SQLite paths
# Used when DB_TYPE=sqlite. Files are created relative to the project root if missing.
# -----------------------------------------------------------------------------
# Live/production SQLite file
# DOCKLINER_SQLITE_DB_PATH=./dockliner.db
# Test SQLite file
# DOCKLINER_SQLITE_TEST_DB_PATH=./dockliner_test.db
# DOCKLINER_SQLITE_DB_NAME=dockliner

# -----------------------------------------------------------------------------
# Users
# JSON array of {user, hash} objects. Passwords must be BLAKE3 512-bit hex hashes (128 hex chars). Example hash generation: echo -n 'your-password' | b3sum -l 64
# -----------------------------------------------------------------------------
# Default root user with blake3('qwer.1234') 512-bit hash
DOCKLINER_USERS=[{"user":"root","hash":"9aa0a2b0f48247f8be3983b37fdbc13a4128da84d4a68ff6690d0202d8883c926f258640f9d8fad34f4b625043195da367307f04274618e734f7b5bf5641a663"}]

# -----------------------------------------------------------------------------
# Driver hints
# pymysql for MySQL, psycopg2 for PostgreSQL.
# -----------------------------------------------------------------------------
# DOCKLINER_DB_DRIVER=pymysql

# -----------------------------------------------------------------------------
# Runtime directories
# Where projects, downloads and logs are stored. Created automatically if missing.
# -----------------------------------------------------------------------------
# DOCKLINER_PROJECTS_DIR=./projects
# DOCKLINER_DOWNLOADS_DIR=./downloads
# DOCKLINER_LOGS_DIR=./logs